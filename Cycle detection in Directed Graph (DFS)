import java.util.*;

class Solution {

    public boolean hasCycle(int n, List<List<Integer>> adj) {

        boolean[] visited = new boolean[n]; // fully explored nodes
        boolean[] inStack = new boolean[n]; // nodes on current DFS path

        // Try DFS from every node (graph may not be fully connected)
        for (int i = 0; i < n; i++) {
            if (!visited[i]) {
                if (dfs(i, adj, visited, inStack)) {
                    return true; // Cycle found
                }
            }
        }
        return false;
    }

    private boolean dfs(int node, List<List<Integer>> adj,
                        boolean[] visited, boolean[] inStack) {

        visited[node] = true;   // Mark as seen
        inStack[node] = true;   // Mark as currently on path

        // Explore all neighbors
        for (int neighbor : adj.get(node)) {

            if (!visited[neighbor]) {
                // Neighbor not explored yet, go deeper
                if (dfs(neighbor, adj, visited, inStack)) {
                    return true; // Cycle found deeper in recursion
                }

            } else if (inStack[neighbor]) {
                // Neighbor already on current path → CYCLE FOUND
                return true;
            }
            // If visited but NOT inStack → already fully explored, safe to skip
        }

        inStack[node] = false;  // Done exploring this node, remove from path
        return false;
    }
}

--------------------------------------------
The Three Cases at Every Neighbor
Neighbor not visited          → Go deeper with DFS

Neighbor visited + inStack    → Cycle! It's on our current path

Neighbor visited + !inStack   → Safe, already fully explored
                                from a previous path, skip it


