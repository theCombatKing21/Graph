class Solution {
    public int findCircleNum(int[][] isConnected) {

        int n = isConnected.length; // n = number of cities (matrix is always n x n)
        boolean[] visited = new boolean[n]; // one slot per city, not per cell
        int provinces = 0;

        // Outer loop visits each CITY, not each matrix cell
        // Cities are just 0, 1, 2 ... n-1 (simple 1D list of nodes)
        for (int i = 0; i < n; i++) {

            if (!visited[i]) {          // Found a city we haven't explored yet
                provinces++;            // This city starts a new province
                visited[i] = true;

                Queue<Integer> queue = new LinkedList<>();
                queue.offer(i);         // Add city number (just an int, not coordinates)

                // BFS - explore all cities connected to city i
                while (!queue.isEmpty()) {

                    int city = queue.poll(); // Take out a city from the front

                    // Scan the ENTIRE ROW of this city in the matrix
                    // Each column j in this row tells us:
                    // "is city j a friend of current city?"
                    for (int j = 0; j < n; j++) {

                        // isConnected[city][j] == 1 means city and j are connected
                        // !visited[j] means we haven't explored city j yet
                        if (isConnected[city][j] == 1 && !visited[j]) {
                            visited[j] = true;
                            queue.offer(j); // Add neighbor city to queue (just a number)
                        }
                    }
                }
                // When queue is empty, entire province is explored
                // Go back to outer loop to find next unvisited city
            }
        }

        return provinces;
    }
}

