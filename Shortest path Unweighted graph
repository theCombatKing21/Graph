	static void BFS(ArrayList<ArrayList<Integer>> adj,int V,int s, int[] dist) 
	{ 
		boolean[] visited=new boolean[V]; 
        
    	Queue<Integer> q=new LinkedList<>();
    	
    	visited[s] = true; 
    	q.add(s); 
    
    	while(q.isEmpty()==false) 
    	{ 
    		int u = q.poll();  
    		 
    		for(int v:adj.get(u)){
    		    if(visited[v]==false){
    		        dist[v]=dist[u]+1; //only this part is new, v is neighbor of u , get v dist= u dist + 1
    		        visited[v]=true;
    		        q.add(v);
    		    }
    		} 
    	} 
	}
