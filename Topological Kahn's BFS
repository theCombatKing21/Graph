	static void topologicalSort(ArrayList<ArrayList<Integer>> adj, int V) 
    { 

//calculate indegree first
        int[] in_degree = new int[V]; 
      
        for (int u = 0; u < V; u++) { 
            for (int x:adj.get(u)) 
                in_degree[x]++; 
        } 

//put all the nodes with zero indegree to the queue

        Queue<Integer> q=new LinkedList<>(); 
        for (int i = 0; i < V; i++) 
            if (in_degree[i] == 0) 
                q.add(i); 
    
      //when you poll from the queue, deduct one indgree from its descendents, if any become zero add them to the queue
        while (q.isEmpty()==false) { 
            int u = q.poll(); 
            System.out.print(u+" "); 
      
            for (int x: adj.get(u)) 
                if (--in_degree[x] == 0) 
                    q.add(x); 
        } 
    
